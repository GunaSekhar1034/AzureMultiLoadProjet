										"type": "Expression"
									},
									"filename": {
										"value": "@activity('LKUP_JOB_DETAILS').output.firstRow.sourcefile",
										"type": "Expression"
									}
								}
							}
						]
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
