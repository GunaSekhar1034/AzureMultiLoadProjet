		"LK_SnowFlake_Blob_Stage_properties_typeProperties_sasToken_secretName": {
			"type": "string",
			"defaultValue": "SAS-token-SnowFlake"
		},
		"LK_Snowflake_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "ABAZURESNOW"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
