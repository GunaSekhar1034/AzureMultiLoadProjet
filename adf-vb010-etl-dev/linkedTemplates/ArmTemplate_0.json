				"typeProperties": {
					"url": "[parameters('LS_JSON_ADLSRAW_properties_typeProperties_url')]",
					"accountKey": {
						"type": "SecureString",
						"value": "[parameters('LS_JSON_ADLSRAW_accountKey')]"
					}
