		"SQL_local_pswd_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://sqlServerPswd.vault.azure.net/"
		},
		"LK_AzureSql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-srvr-vb-dev-f.database.windows.net"
