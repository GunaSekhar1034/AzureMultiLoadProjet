		{
			"name": "[concat(parameters('factoryName'), '/LS_JSON_ADLSRAW')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('LS_JSON_ADLSRAW_properties_typeProperties_url')]",
