		{
			"name": "[concat(parameters('factoryName'), '/SQL_local_pswd')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureKeyVault",
				"typeProperties": {
					"baseUrl": "[parameters('SQL_local_pswd_properties_typeProperties_baseUrl')]"
				}
			},
			"dependsOn": []
