							"value": "@concat(\n    dataset().TgtDirectory,'/',\n    formatDateTime(utcNow(),'yyyy'),'/',\n    formatDateTime(utcNow(),'MM'),'/',\n    formatDateTime(utcNow(),'dd')\n)",
							"type": "Expression"
						},
						"fileSystem": "input"
