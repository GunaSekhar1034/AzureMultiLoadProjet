					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": "olist_customers_dataset",
						"folderPath": {
							"value": "@concat(\n    'SFTP/',\n    formatDateTime(utcNow(),'yyyy'),'/',\n    formatDateTime(utcNow(),'MM'),'/',\n    formatDateTime(utcNow(),'dd')\n)",
