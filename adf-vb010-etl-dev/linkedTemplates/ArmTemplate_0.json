					"accountIdentifier": "EYEDOPT-UX23027",
					"user": "GUNA10345",
					"database": "[parameters('LK_Snowflake_properties_typeProperties_database')]",
					"warehouse": "COMPUTE_WH",
					"password": {
						"type": "AzureKeyVaultSecret",
						"store": {
							"referenceName": "Key_SnowFlake",
