		"LK_AzureSql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sql-db-vb-dev"
		},
		"LK_AzureSql_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "access-data-dev"
		},
