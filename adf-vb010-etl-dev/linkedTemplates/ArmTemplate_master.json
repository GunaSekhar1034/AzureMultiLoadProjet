{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-vb010-etl-dev"
		},
		"DL_ADLSSRC_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'DL_ADLSSRC'"
		},
		"LS_JSON_ADLSRAW_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_JSON_ADLSRAW'"
		},
		"DL_ADLSSRC_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsdevvbsrc.dfs.core.windows.net/"
		},
		"LS_JSON_ADLSRAW_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsdevfinalraw.dfs.core.windows.net/"
		},
		"LS_RestAPI_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://retoolapi.dev/sGwPeG/product_category_name_translation"
		},
		"LS_SqlServer_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "GUNA_SEKHAR\\MSLOCALDB"
		},
		"LS_SqlServer_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "vbadeproject"
		},
		"LS_SqlServer_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sa"
		},
		"SQL_local_pswd_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://sqlServerPswd.vault.azure.net/"
		},
		"Key_SnowFlake_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://sqlServerPswd.vault.azure.net/"
		},
		"LK_Snowflake_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "ABAZURESNOW"
		},
		"LK_SnowFlake_Blob_Stage_sasUri": {
			"type": "secureString",
			"metadata": "Secure string for 'sasUri' of 'LK_SnowFlake_Blob_Stage'"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-vb010-etl-dev_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"DL_ADLSSRC_accountKey": {
						"value": "[parameters('DL_ADLSSRC_accountKey')]"
					},
					"LS_JSON_ADLSRAW_accountKey": {
						"value": "[parameters('LS_JSON_ADLSRAW_accountKey')]"
					},
					"DL_ADLSSRC_properties_typeProperties_url": {
						"value": "[parameters('DL_ADLSSRC_properties_typeProperties_url')]"
					},
					"LS_JSON_ADLSRAW_properties_typeProperties_url": {
						"value": "[parameters('LS_JSON_ADLSRAW_properties_typeProperties_url')]"
					},
					"LS_RestAPI_properties_typeProperties_url": {
						"value": "[parameters('LS_RestAPI_properties_typeProperties_url')]"
					},
					"SQL_local_pswd_properties_typeProperties_baseUrl": {
						"value": "[parameters('SQL_local_pswd_properties_typeProperties_baseUrl')]"
					},
					"Key_SnowFlake_properties_typeProperties_baseUrl": {
						"value": "[parameters('Key_SnowFlake_properties_typeProperties_baseUrl')]"
					},
					"LK_SnowFlake_Blob_Stage_sasUri": {
						"value": "[parameters('LK_SnowFlake_Blob_Stage_sasUri')]"
					},
					"LS_SqlServer_properties_typeProperties_server": {
						"value": "[parameters('LS_SqlServer_properties_typeProperties_server')]"
					},
					"LS_SqlServer_properties_typeProperties_database": {
						"value": "[parameters('LS_SqlServer_properties_typeProperties_database')]"
					},
					"LS_SqlServer_properties_typeProperties_userName": {
						"value": "[parameters('LS_SqlServer_properties_typeProperties_userName')]"
					},
					"LK_Snowflake_properties_typeProperties_database": {
						"value": "[parameters('LK_Snowflake_properties_typeProperties_database')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "adf-vb010-etl-dev_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'adf-vb010-etl-dev_ArmTemplate_0')]"
			]
		}
	]
}