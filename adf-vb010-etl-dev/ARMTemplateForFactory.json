										}
									},
									{
										"source": {
											"path": "$['greeting']"
										},
										"sink": {
											"name": "greeting"
										}
									},
									{
										"source": {
											"path": "$['favoriteFruit']"
										},
										"sink": {
											"name": "favoriteFruit"
										}
									}
								],
								"collectionReference": "$['tags']",
