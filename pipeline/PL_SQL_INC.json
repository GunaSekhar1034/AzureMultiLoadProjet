{
	"name": "PL_SQL_INC",
	"properties": {
		"activities": [
			{
				"name": "LKP_MAX_VAL",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": {
							"value": "select max(@{pipeline().parameters.Watermark}) as maxValue\nfrom @{pipeline().parameters.Schema}.@{pipeline().parameters.Table}",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DB_SqlServer_MaxVal",
						"type": "DatasetReference",
						"parameters": {
							"SchamaName": {
								"value": "@pipeline().parameters.Schema",
								"type": "Expression"
							},
							"TableName": {
								"value": "@pipeline().parameters.Table",
								"type": "Expression"
							}
						}
					}
				}
			},
			{
				"name": "If_INC",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "LKP_MAX_VAL",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@or(\nequals(pipeline().parameters.LLV, null),\ngreater(int(coalesce(activity('LKP_MAX_VAL').output.firstRow.maxValue,0)),int(pipeline().parameters.LLV))\n)",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "CPY_Load_Data",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "SqlServerSource",
									"sqlReaderQuery": {
										"value": "@concat('select * from', \npipeline().parameters.Schema,'.',pipeline().parameters.Table,\nif(\n    equals(pipeline().parameters.LLV, null), '', \nconcat(' where ',pipeline().parameters.Watermark, '>', pipeline().parameters.LLV)\n)\n)",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"sink": {
									"type": "ParquetSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "ParquetWriteSettings"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "DB_SqlServer_MaxVal",
									"type": "DatasetReference",
									"parameters": {
										"SchamaName": {
											"value": "@pipeline().parameters.Schema",
											"type": "Expression"
										},
										"TableName": {
											"value": "@pipeline().parameters.Table",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DB_SQL_Parquet",
									"type": "DatasetReference",
									"parameters": {
										"TableName": {
											"value": "@pipeline().parameters.Table",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "SP_Update_Watermark",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "CPY_Load_Data",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[dbo].[UpdateWatermark]",
								"storedProcedureParameters": {
									"TableName": {
										"value": {
											"value": "@pipeline().parameters.Table",
											"type": "Expression"
										},
										"type": "String"
									},
									"TableSchema": {
										"value": {
											"value": "@pipeline().parameters.Schema",
											"type": "Expression"
										},
										"type": "String"
									},
									"WatermarkColumn": {
										"value": {
											"value": "@pipeline().parameters.Watermark",
											"type": "Expression"
										},
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "LS_SqlServer",
								"type": "LinkedServiceReference"
							}
						}
					]
				}
			}
		],
		"parameters": {
			"Schema": {
				"type": "string"
			},
			"Table": {
				"type": "string"
			},
			"Watermark": {
				"type": "string"
			},
			"LLV": {
				"type": "string"
			}
		},
		"annotations": []
	}
}